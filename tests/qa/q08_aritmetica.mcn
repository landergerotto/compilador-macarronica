    a receba 17;
    b receba 5;
    imprimeInteira(a - a // b * b);
    imprimePalavra(" ");
    imprimeInteira(-a - -a // b * b);
    imprimeNl();
    imprimeInteira(2 + 3 * 4 - 10 // 3);
    imprimeNl();
    imprimeInteira((2 + 3) * (4 - 10) // 3);
    imprimeNl();
    imprimeInteira(2 * 3 ^ 2);
    imprimeNl();
    imprimeInteira(- - 5);
    imprimePalavra(" ");
