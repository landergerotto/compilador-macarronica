inteira principal() @
[
    duplocarpado d, dez, dois;
    imprimeFlut(0.0);
    imprimePalavra(" ");
    imprimeFlut(-0.0);
    imprimePalavra(" ");
    imprimeFlut(1.0);
    imprimePalavra(" ");
    imprimeFlut(-2.5);
    imprimeNl();
    imprimeFlut(123456.789);
    imprimePalavra(" ");
    imprimeFlut(0.000001);
    imprimePalavra(" ");
    imprimeFlut(100000000.0);
    imprimePalavra(" ");
    imprimeFlut(1000000000.0);
    imprimeNl();
    imprimeFlut(0.1 + 0.2);
    imprimePalavra(" ");
    imprimeFlut(1.0 / 3.0);
    imprimePalavra(" ");
    imprimeFlut(16777216.0 + 1.0);
    imprimePalavra(" ");
    imprimeFlut(0.0001);
    imprimePalavra(" ");
    imprimeFlut(0.00001);
    imprimeNl();
    dez receba 10;
    d receba 1;
    d receba d / dez;
    imprimeDuplocarpado(d);
    imprimePalavra(" ");
    imprimeDuplocarpado(d + d + d);
    imprimePalavra(" ");
    imprimeDuplocarpado(dez ^ (dez + dez));
    imprimePalavra(" ");
    imprimeDuplocarpado(d / (dez * dez * dez * dez * dez * dez));
    imprimeNl();
    imprimeDuplocarpado(-d);
    imprimePalavra(" ");
    dois receba 2;
    imprimeDuplocarpado(raiz(dois));
    imprimePalavra(" ");
    imprimeDuplocarpado(dois ^ (dez * dez));
    imprimeNl();
    respost 0;
]
