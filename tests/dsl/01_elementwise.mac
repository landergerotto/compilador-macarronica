inteira principal() @
[
    inteira vet{3} a, b, c;
    inteira i;
    repete (i receba 0, i < 3, i receba i + 1) edai
    [
        a{i} receba i + 1;
        b{i} receba i + 4;
    ]
    c receba a + b;
    repete (i receba 0, i < 3, i receba i + 1) edai
    [
        cond (c{i} ! (a{i} + b{i})) edai [ respost 1; ]
    ]
    c receba a - b;
    repete (i receba 0, i < 3, i receba i + 1) edai
    [
        cond (c{i} ! (a{i} - b{i})) edai [ respost 2; ]
    ]
    c receba a * b;
    repete (i receba 0, i < 3, i receba i + 1) edai
    [
        cond (c{i} ! (a{i} * b{i})) edai [ respost 3; ]
    ]
    a receba a + b;
    repete (i receba 0, i < 3, i receba i + 1) edai
    [
        cond (a{i} ! ((i + 1) + b{i})) edai [ respost 4; ]
    ]
    imprimePalavra("elementwise OK");
    imprimeNl();
    respost 0;
]
